---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { CONTACT_PHONE_DISPLAY, SITE } from '../config';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'article' | 'website';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  ogImage = '/assets/og-default.jpg',
  ogImageAlt = 'Zimmero Hotelsoftware, Zimmerplan mit Buchungen',
  ogType = 'website',
  structuredData,
} = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonical || path, SITE.url).toString();
const ogImageUrl = new URL(ogImage, SITE.url).toString();
const pageStructuredData = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://zimmero.app/#organization',
    name: 'Zimmero',
    legalName: 'BavarianBits GmbH',
    url: 'https://zimmero.app',
    logo: 'https://zimmero.app/logo.svg',
    image: 'https://zimmero.app/assets/og-default.jpg',
    description: 'Hotelsoftware für kleine Hotels und Pensionen inklusive Channel Manager, digitalem Meldeschein und Kurtaxenabrechnung.',
    email: 'info@zimmero.app',
    telephone: CONTACT_PHONE_DISPLAY,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Zur Limestherme 4',
      postalCode: '93333',
      addressLocality: 'Bad Gögging',
      addressRegion: 'Bayern',
      addressCountry: 'DE',
    },
    areaServed: [
      { '@type': 'Country', name: 'Deutschland' },
      { '@type': 'Country', name: 'Österreich' },
    ],
    founder: { '@type': 'Person', name: 'Andreas Huber' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://zimmero.app/#website',
    name: 'Zimmero',
    url: 'https://zimmero.app',
    inLanguage: 'de-DE',
    publisher: { '@id': 'https://zimmero.app/#organization' },
  },
  ...pageStructuredData,
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#4a6fe3" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>

    <script is:inline>
      window.plausible = window.plausible || function () {
        (window.plausible.q = window.plausible.q || []).push(arguments);
      };
    </script>
    <script defer data-domain="zimmero.app" src="https://analytics.bavarianbits.de/js/script.js"></script>

    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
  </head>
  <body class="min-h-screen flex flex-col bg-white">
    <Navigation />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { installAnalytics } from '../scripts/analytics.js';
      installAnalytics();
    </script>
  </body>
</html>
