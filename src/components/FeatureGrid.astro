---
import { featureGroups } from '../data/features';

interface Props {
  complete?: boolean;
}

const { complete = false } = Astro.props;
---

<div class="grid gap-px overflow-hidden rounded-2xl border border-secondary-200 bg-secondary-200 sm:grid-cols-2 lg:grid-cols-3">
  {featureGroups.map(group => (
    <article class="min-w-0 bg-white p-5 sm:p-6 lg:p-7">
      <span class="product-icon mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={group.icon} />
        </svg>
      </span>
      <h3 class="mb-3 text-lg font-semibold">{group.title}</h3>
      <ul class="product-list">
        {group.summary.map(item => <li>{item}</li>)}
      </ul>
      {complete && (
        <details class="mt-4 border-t border-secondary-100 pt-3 text-sm">
          <summary class="cursor-pointer font-semibold text-primary-700">Weitere Funktionen</summary>
          <ul class="product-list mt-3">
            {group.details.map(item => <li>{item}</li>)}
          </ul>
          {group.link && <a class="product-link mt-3" href={group.link.href}>{group.link.label}<span aria-hidden="true">↗</span></a>}
        </details>
      )}
    </article>
  ))}
</div>
