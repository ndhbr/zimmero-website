---

<section id="funktionen" class="bg-surface py-16 md:py-24">
  <div class="section-container">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <h2 class="mb-4 text-2xl font-bold md:text-3xl">Die täglichen Abläufe in einem System.</h2>
      <p class="leading-relaxed text-secondary-600">
        Jede Funktion greift dort, wo an der Rezeption sonst eine Liste, ein zweites Programm oder eine Rückfrage nötig wäre.
      </p>
    </div>

    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {features.map(feature => (
        <article class="rounded-xl border border-secondary-200 bg-white p-6 shadow-sm">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-50">
            <svg class="h-5 w-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="mb-2 font-semibold text-secondary-900">{feature.title}</h3>
          <p class="text-sm leading-relaxed text-secondary-600">{feature.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
