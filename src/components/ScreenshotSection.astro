---
const screenshots = [
  { src: 'preischeck.webp', width: 3018, height: 1628, title: 'Preischeck', alt: 'Preischeck mit Reisezeitraum, Belegung und Zimmerauswahl' },
  { src: 'rechnungen.webp', width: 2990, height: 1630, title: 'Rechnungen', alt: 'Rechnungsansicht mit Leistungen eines Aufenthalts' },
  { src: 'putzplan.webp', width: 2354, height: 1612, title: 'Housekeeping', alt: 'Putzplan mit Zimmerstatus und Reinigungsaufgaben' },
  { src: 'gastronomie.webp', width: 2840, height: 1622, title: 'Gastronomie-Tablet', alt: 'Gastronomieansicht mit Zimmerzuordnung und Produktkacheln' },
];
---

<section class="product-section border-t border-secondary-200 bg-secondary-50" aria-labelledby="screenshot-heading">
  <div class="product-container">
    <h2 id="screenshot-heading" class="product-heading mb-6">Zimmero im Hotelalltag</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {screenshots.map(shot => (
        <figure class="overflow-hidden rounded-xl border border-secondary-200 bg-white">
          <a href={`/assets/${shot.src}`} target="_blank" rel="noopener" class="block" aria-label={`${shot.title} in voller Größe öffnen`}>
            <img src={`/assets/${shot.src}`} alt={shot.alt} width={shot.width} height={shot.height} class="aspect-video h-auto w-full object-cover object-top" loading="lazy" decoding="async" />
          </a>
          <figcaption class="border-t border-secondary-200 px-4 py-3 text-sm font-semibold">{shot.title}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
