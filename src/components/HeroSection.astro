---
import { DEMO_URL } from '../config';
import { plans } from '../data/pricing';
---

<section id="zielgruppe" aria-labelledby="willkommen" class="border-b border-secondary-200/80 bg-[#fbfcff] py-12 lg:py-[4.5rem]">
  <div class="product-container grid items-center gap-10 lg:grid-cols-[.84fr_1.16fr] lg:gap-9">
    <div>
      <p class="product-kicker mb-4">Für inhabergeführte Hotels und Pensionen</p>
      <h1 id="willkommen" class="product-title">All-in-One-<wbr />Hotelsoftware für Ihren Alltag.</h1>
      <p class="mt-5 max-w-[31rem] text-base leading-relaxed text-secondary-600 sm:text-lg">
        Zimmero verbindet Zimmerplan, Reservierungen, Vertrieb, Rechnungen und Housekeeping in einem System. Für Gasthöfe und kleine Hotelgruppen ebenso wie für einzelne Häuser.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={DEMO_URL} target="_blank" rel="noopener" class="btn-primary">
          Demo öffnen <span aria-hidden="true">↗</span>
        </a>
        <a href="/preise/" class="btn-secondary bg-white">Preise ansehen</a>
      </div>
      <p class="mt-3 text-sm text-secondary-600">Ab <strong class="font-semibold text-secondary-900">{plans[0].price} € netto</strong> pro Monat</p>
      <p class="mt-6 flex items-center gap-2.5 text-sm font-semibold text-secondary-800">
        <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-success-100 text-success-800" aria-hidden="true">✓</span>
        15+ Hotels nutzen bereits Zimmero
      </p>
    </div>

    <figure class="product-hero-stage min-w-0 rounded-[1.5rem] border border-primary-100 px-3 py-6 sm:p-8 lg:p-5 xl:p-7">
      <div class="product-frame">
        <div class="flex items-center gap-3 border-b border-secondary-200 bg-secondary-50 px-3 py-2.5 text-xs font-medium text-secondary-600">
          <img src="/logo.svg" alt="" width="16" height="16" class="!w-4 !h-4" />
          <span>Zimmero · Digitaler Zimmerplan</span>
        </div>
        <a href="/assets/zimmerplan-v2.webp" target="_blank" rel="noopener" class="block" aria-label="Zimmerplan in voller Größe öffnen">
          <img
            src="/assets/zimmerplan-1360.webp"
            srcset="/assets/zimmerplan-680.webp 680w, /assets/zimmerplan-1360.webp 1360w, /assets/zimmerplan-v2.webp 2720w"
            sizes="(min-width: 1264px) 603px, (min-width: 1024px) 53vw, (min-width: 640px) calc(100vw - 130px), calc(100vw - 66px)"
            alt="Der digitale Zimmerplan von Zimmero zeigt Reservierungen, Aufenthalte und gesperrte Zimmer."
            width="1360"
            height="701"
            fetchpriority="high"
          />
        </a>
      </div>
    </figure>
  </div>
</section>
