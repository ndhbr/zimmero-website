---
import { CONTACT_EMAIL, DEMO_URL } from '../config';
---

<section class="pt-16 md:pt-24 pb-12 md:pb-16">
  <div class="section-container">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-medium text-primary-600 mb-4">
        Für inhabergeführte Hotels, Pensionen und kleine Hotelgruppen
      </p>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-secondary-900 mb-6 leading-tight">
        Die moderne Betriebssoftware für inhabergeführte Hotels
      </h1>
      <p class="text-lg md:text-xl text-secondary-600 mb-8 max-w-3xl mx-auto leading-relaxed">
        Zimmero bringt Zimmerplan, Buchungen, Preise, Rechnungen, Housekeeping, Channel Manager, digitalen Meldeschein, Kurtaxe und Online Check-in in ein System für den Hotelalltag.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-4">
        <a href={DEMO_URL} target="_blank" rel="noopener" class="btn-primary px-8 py-3.5 inline-flex items-center gap-2">
          Demo öffnen
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <a href="/kontakt/" class="btn-secondary px-8 py-3.5">Zimmero anfragen</a>
      </div>
      <p class="text-sm text-secondary-600">Oder schreiben Sie direkt an <a href={`mailto:${CONTACT_EMAIL}?subject=Anfrage%20zu%20Zimmero`} class="font-medium text-primary-700 hover:underline">{CONTACT_EMAIL}</a>.</p>
    </div>

    <div class="mt-12 md:mt-16 max-w-5xl mx-auto">
      <img
        src="/assets/zimmerplan.webp"
        alt="Zimmero Zimmerplan mit Buchungen, Aufenthalten und blockierten Zimmern"
        width="2334"
        height="1572"
        class="block h-auto w-full"
        loading="eager"
      />
    </div>
  </div>
</section>
