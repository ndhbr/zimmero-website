---
const details = [
  ['Geburtstagspost', 'Exportieren Sie Geburtstagsetiketten für Ihre Stammgastpost.'],
  ['Gäste anlegen', 'Die Adressvervollständigung spart Tipparbeit bei der Erfassung.'],
  ['Tagespost', 'Stellen Sie Informationen und Unterlagen für einzelne Zimmer bereit.'],
  ['Späte Anreise', 'Halten Sie die Hinweise direkt beim Aufenthalt fest.'],
  ['Zimmer zeigen', 'Hinterlegen Sie Fotos zu jedem Zimmertyp.'],
  ['Änderungen verstehen', 'Sehen Sie das Änderungsprotokoll direkt im Produkt ein.'],
  ['Neuerungen verfolgen', 'Lesen Sie laufend veröffentlichte Produktneuerungen in Zimmero.'],
];
---

<section class="bg-surface py-16 md:py-24">
  <div class="section-container">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <h2 class="mb-4 text-2xl font-bold md:text-3xl">Kleinigkeiten, die den Alltag angenehmer machen.</h2>
        <p class="leading-relaxed text-secondary-600">
          Nicht jede hilfreiche Funktion braucht ein eigenes Modul. Oft sparen die kleinen Handgriffe jeden Tag die meiste Zeit.
        </p>
      </div>
      <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {details.map(([title, text]) => (
          <li class="rounded-xl border border-secondary-200 bg-white p-5 shadow-sm">
            <h3 class="mb-1 font-semibold text-secondary-900">{title}</h3>
            <p class="text-sm leading-relaxed text-secondary-600">{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
