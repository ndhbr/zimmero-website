---
interface Faq {
  q: string;
  a: string;
}

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<div class="space-y-4">
  {faqs.map(faq => (
    <details class="group overflow-hidden rounded-xl border border-secondary-200 bg-white shadow-sm">
      <summary class="flex cursor-pointer items-center justify-between p-5 text-left font-medium text-secondary-900 transition-colors hover:bg-secondary-50">
        <span>{faq.q}</span>
        <svg class="ml-4 h-5 w-5 shrink-0 text-secondary-500 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="px-5 pb-5 text-sm leading-relaxed text-secondary-600">
        {faq.a}
      </div>
    </details>
  ))}
</div>
