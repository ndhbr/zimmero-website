---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Layout from '../../layouts/Layout.astro';
import { CONTACT_EMAIL } from '../../config';

const title = 'HS3 Alternative mit Datenübernahme | Zimmero';
const description = 'Zimmero ist eine HS3 Hotelsoftware Alternative mit direkter Datenübernahme. Gäste, Reservierungen und Historie per Testimport prüfen und weiterführen.';
const canonical = '/wissen/hs3-alternative/';
const ogImage = '/assets/og-default.jpg';
const migrationMail = `mailto:${CONTACT_EMAIL}?subject=HS3-Daten%C3%BCbernahme%20pr%C3%BCfen%20lassen`;

const migrationGroups = [
  {
    title: 'Gäste & Firmen',
    items: ['Gästestammdaten', 'Kontaktdaten und Adressen', 'Firmen', 'weitere vorhandene Stammdaten'],
  },
  {
    title: 'Reservierungen & Aufenthalte',
    items: ['zukünftige Reservierungen', 'bestehende Aufenthalte', 'historische Aufenthalte', 'Buchungsinformationen'],
  },
  {
    title: 'Zimmer & Zuordnungen',
    items: ['Zimmer', 'Zimmerbezüge', 'Zuordnungen', 'relevante Belegungsinformationen'],
  },
  {
    title: 'Preise & Leistungen',
    items: ['vorhandene Preise', 'gebuchte Leistungen', 'weitere abrechnungsrelevante Informationen'],
  },
  {
    title: 'Historie & weitere Angaben',
    items: ['Notizen', 'historische Daten', 'weitere verfügbare Informationen aus HS3'],
  },
];

const migrationSteps = [
  {
    title: 'HS3-Datenbestand prüfen',
    text: 'Wir sehen uns die vorhandene Installation beziehungsweise Datenbank an und klären, welche Informationen übernommen werden können.',
  },
  {
    title: 'Testimport durchführen',
    text: 'Wir übernehmen den Datenbestand testweise in Zimmero und kontrollieren die für Ihren Betrieb relevanten Informationen gemeinsam.',
  },
  {
    title: 'Zimmero vorbereiten',
    text: 'Haus, Benutzer, Einstellungen, Abläufe und benötigte Schnittstellen werden für den Wechsel eingerichtet.',
  },
  {
    title: 'Aktuellen Stand übernehmen',
    text: 'Zum vereinbarten Stichtag folgt der aktuelle Datenstand. Danach arbeitet Ihr Team direkt in Zimmero weiter.',
  },
];

const featureGroups = [
  {
    title: 'Reservierung & Rezeption',
    items: [
      { label: 'moderner Zimmerplan' },
      { label: 'Reservierungen und Angebote' },
      { label: 'Gäste- und Firmenverwaltung' },
      { label: 'Anreise und Abreise' },
    ],
  },
  {
    title: 'Verkauf & Buchungen',
    items: [
      { label: 'Channel Manager mit Booking.com und weiteren OTAs', href: '/channel-manager-booking-com/' },
      { label: 'provisionsfreie Direktbuchung über die eigene Website', href: '/online-buchungssystem-hotelwebsite/' },
      { label: 'eigene Buchungsstrecke' },
      { label: 'Preisverwaltung' },
    ],
  },
  {
    title: 'Rechnung & Verwaltung',
    items: [
      { label: 'Rechnungen und Leistungen' },
      { label: 'DATEV Export', href: '/datev-export-hotel/' },
      { label: 'digitaler Meldeschein', href: '/meldeschein-software/' },
      { label: 'Kurtaxe und Ortstaxe', href: '/kurtaxe-ortstaxe-software/' },
      { label: 'Tourismusstatistik', href: '/tourismusstatistik-bayern/' },
    ],
  },
  {
    title: 'Hotelbetrieb',
    items: [
      { label: 'Housekeeping und Putzplan' },
      { label: 'Online Check-in', href: '/online-check-in-hotel/' },
      { label: 'Gästeportal' },
      { label: 'E-Mail-Kommunikation' },
    ],
  },
];

const screenshots = [
  {
    src: '/assets/zimmerplan.webp',
    alt: 'Zimmerplan der Zimmero Hotelsoftware mit Reservierungen und Zimmerbelegung',
    width: 2334,
    height: 1572,
    title: 'Zimmerplan',
    text: 'Reservierungen, Aufenthalte und Zimmerbelegung in einer gemeinsamen Ansicht.',
  },
  {
    src: '/assets/buchungsuebersicht.webp',
    alt: 'Buchungsübersicht in Zimmero mit Gästedaten, Status und Leistungen',
    width: 2990,
    height: 1594,
    title: 'Buchungsübersicht',
    text: 'Gäste, Status und Leistungen bleiben am jeweiligen Vorgang nachvollziehbar.',
  },
  {
    src: '/assets/rechnungen.webp',
    alt: 'Rechnungsansicht der Zimmero Hotelsoftware mit Positionen und PDF-Vorschau',
    width: 2990,
    height: 1630,
    title: 'Rechnungen',
    text: 'Leistungen abrechnen, Rechnungen aufteilen und als PDF archivieren.',
  },
];

const faqs = [
  {
    q: 'Wird die HS3 Hotelsoftware eingestellt?',
    a: 'HS3 ist Stand 10. September 2026 noch in Betrieb. In der offiziellen FAQ zur Übernahme kündigen HS3 und Mews jedoch an, dass Produkte künftig auslaufen sollen. Dort wird ein voraussichtlicher Unterstützungszeitraum von drei Jahren nach Mai 2024 genannt.',
  },
  {
    q: 'Wann endet der Support für HS3?',
    a: 'Die offizielle HS3-FAQ nennt kein verbindliches tagesgenaues Supportende. Sie beschreibt einen voraussichtlichen Zeitraum von drei Jahren nach Mai 2024. Das deutet ungefähr auf Mai 2027 hin, ersetzt aber keine individuelle Mitteilung oder vertragliche Auskunft von HS3 beziehungsweise Mews.',
  },
  {
    q: 'Ist Mews der einzige HS3-Nachfolger?',
    a: 'Nein. Mews hat HS3 im Mai 2024 übernommen und bietet HS3-Kunden die Migration zur Mews Hospitality Cloud an. Bestehende HS3-Nutzer können grundsätzlich auch andere Hotelsoftwares prüfen. Welche HS3 Alternative passt, hängt vom Betrieb, den benötigten Funktionen, den Schnittstellen und der gewünschten Datenübernahme ab.',
  },
  {
    q: 'Kann Zimmero meine bestehenden HS3-Daten übernehmen?',
    a: 'Ja. Zimmero kann den vorhandenen Datenbestand einer HS3-Installation direkt für die Migration auslesen. Dazu können unter anderem Gäste, Firmen, Reservierungen, Aufenthalte, Zimmer, Preise, Leistungen, Notizen und historische Daten gehören. Der tatsächlich übertragbare Umfang wird vorab geprüft.',
  },
  {
    q: 'Muss ich meine Gäste und Reservierungen manuell aus HS3 exportieren?',
    a: 'In der Regel nicht. Zimmero kann direkt auf den vorhandenen HS3-Datenbestand zugreifen. Dadurch ist kein manueller Export sämtlicher Gäste und Reservierungen in einzelne Excel- oder CSV-Dateien erforderlich.',
  },
  {
    q: 'Was ist die HS3.FDB?',
    a: 'Bei vielen HS3-Installationen befindet sich der Datenbestand in einer Firebird-Datenbank mit dem Dateinamen HS3.FDB. Zimmero kann diese vorhandene HS3 Datenbank direkt für die Migration auslesen. Als Hotelier müssen Sie die technische Struktur der Datei nicht kennen.',
  },
  {
    q: 'Kann Zimmero eine HS3 FDB importieren?',
    a: 'Ja. Zimmero kann eine vorhandene HS3.FDB auslesen und die enthaltenen, für die Migration vorgesehenen Daten in Zimmero übertragen. Welche Datenfelder konkret vorhanden und übertragbar sind, wird mit dem tatsächlichen Datenbestand geprüft.',
  },
  {
    q: 'Können zukünftige Reservierungen aus HS3 übernommen werden?',
    a: 'Ja. Zukünftige Reservierungen können im Rahmen der HS3 Datenübernahme in Zimmero übernommen werden, sodass sie nach dem Wechsel nicht manuell neu angelegt werden müssen.',
  },
  {
    q: 'Werden auch historische Daten übernommen?',
    a: 'Auch historische Daten aus dem vorhandenen HS3-Datenbestand können übernommen werden. Welche Informationen konkret vorhanden und sinnvoll übertragbar sind, wird vor der Umstellung geprüft.',
  },
  {
    q: 'Kann ich die Datenübernahme vor dem Wechsel testen?',
    a: 'Ja. Vor dem produktiven Wechsel kann ein Testimport durchgeführt werden. Dadurch können die übernommenen Daten vor der eigentlichen Umstellung geprüft werden.',
  },
  {
    q: 'Wie läuft der Wechsel von HS3 zu Zimmero ab?',
    a: 'Zunächst prüfen wir den vorhandenen HS3-Datenbestand. Anschließend erfolgt ein Testimport in Zimmero. Danach werden die benötigten Einstellungen und Abläufe vorbereitet. Zum vereinbarten Stichtag wird der aktuelle Datenstand übernommen und der Hotelbetrieb arbeitet anschließend in Zimmero weiter.',
  },
  {
    q: 'Wie lange dauert der Wechsel von HS3 zu Zimmero?',
    a: 'Das hängt vom vorhandenen Datenbestand, der Größe des Betriebs und den benötigten Einstellungen und Schnittstellen ab. Vor der Umstellung stimmen wir den Ablauf und einen geeigneten Wechseltermin gemeinsam ab.',
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'HS3 Alternative mit vollständiger Datenübernahme',
  description,
  image: `https://zimmero.app${ogImage}`,
  datePublished: '2026-09-01',
  dateModified: '2026-09-10',
  inLanguage: 'de-DE',
  author: { '@type': 'Person', name: 'Andreas Huber' },
  publisher: { '@id': 'https://zimmero.app/#organization' },
  mainEntityOfPage: `https://zimmero.app${canonical}`,
  about: [
    { '@type': 'SoftwareApplication', name: 'HS3 Hotelsoftware' },
    { '@type': 'Thing', name: 'HS3 Alternative' },
    { '@type': 'Thing', name: 'HS3 Datenübernahme' },
  ],
  keywords: ['HS3 Alternative', 'HS/3 Alternative', 'HS3 Hotelsoftware Alternative', 'HS3 Nachfolger', 'HS3 Datenübernahme', 'HS3.FDB'],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbs = [
  { name: 'Startseite', href: '/' },
  { name: 'Wissen', href: '/wissen/' },
  { name: 'HS3 Alternative', href: canonical },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageAlt="Zimmero als Alternative zur HS3 Hotelsoftware"
  ogType="article"
  structuredData={[articleSchema, faqSchema]}
>
  <article>
    <header class="overflow-hidden bg-primary-50 py-10 md:py-16 lg:py-20">
      <div class="section-container">
        <Breadcrumbs items={breadcrumbs} />

        <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.92fr)_minmax(520px,1.08fr)] lg:gap-14">
          <div>
            <p class="mb-3 text-sm font-semibold text-primary-700">HS3 Alternative mit Datenübernahme</p>
            <h1 class="mb-6 max-w-3xl text-3xl font-bold tracking-tight md:text-5xl lg:text-[3.4rem]">
              HS3 Alternative mit vollständiger Datenübernahme
            </h1>
            <p class="max-w-2xl text-lg leading-relaxed text-secondary-700 md:text-xl">
              Wechseln Sie zu Zimmero, ohne Gäste, Reservierungen und historische Daten neu erfassen zu müssen. Wir übernehmen Ihren vorhandenen HS3-Datenbestand und bereiten ihn für die weitere Nutzung in Zimmero auf.
            </p>
            <p class="mt-5 border-l-4 border-primary-500 pl-4 font-semibold text-secondary-900">
              Nach der Umstellung arbeiten Sie dort weiter, wo Sie in HS3 aufgehört haben.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href={migrationMail} data-event="HS3 Datenuebernahme angefragt" class="btn-primary px-7 py-3.5">Datenübernahme prüfen lassen</a>
              <a href="/demo/" class="btn-secondary bg-white px-7 py-3.5">Zimmero Demo ansehen</a>
            </div>

            <ul class="mt-8 grid gap-x-5 gap-y-3 text-sm text-secondary-700 sm:grid-cols-2" aria-label="Vorteile beim Wechsel">
              {['Datenübernahme aus HS3', 'Testimport vor dem Wechsel', 'Kein manuelles Neuerfassen', 'Persönliche Begleitung'].map(item => (
                <li class="flex items-center gap-2">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-success-100 font-bold text-success-700" aria-hidden="true">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <figure class="overflow-hidden rounded-2xl border border-secondary-200 bg-white shadow-xl shadow-primary-900/10">
            <img src="/assets/zimmerplan.webp" alt="Zimmerplan der Zimmero Hotelsoftware nach einer HS3-Datenübernahme" width="2334" height="1572" class="h-auto w-full object-cover object-top" loading="eager" fetchpriority="high" />
            <figcaption class="border-t border-secondary-200 px-5 py-4 text-sm text-secondary-600">Echte Zimmero-Oberfläche: offene Buchungen und Aufenthalte im Zimmerplan weiterführen.</figcaption>
          </figure>
        </div>
      </div>
    </header>

    <section id="datenuebernahme" class="py-16 md:py-24" aria-labelledby="daten-heading">
      <div class="section-container">
        <div class="mx-auto max-w-4xl text-center">
          <p class="mb-3 text-sm font-semibold text-primary-700">Ihre bestehenden HS3-Daten kommen mit</p>
          <h2 id="daten-heading" class="mb-5 text-3xl font-bold md:text-4xl">Kein Neustart mit einem leeren System.</h2>
          <p class="text-lg leading-relaxed text-secondary-600">Beim Wechsel zu Zimmero greifen wir auf den bestehenden Datenbestand Ihrer HS3-Installation zurück. Sie müssen nicht zunächst hunderte Gäste, Buchungen und Stammdaten einzeln exportieren und anschließend neu erfassen.</p>
        </div>

        <ol class="mx-auto mt-12 grid max-w-5xl gap-3 md:grid-cols-4" aria-label="Datenweg von HS3 zu Zimmero">
          {['Bestehendes HS3', 'Datenübernahme', 'Gemeinsame Prüfung', 'In Zimmero weiterarbeiten'].map((label, index) => (
            <li class="relative flex min-h-28 items-center justify-center rounded-xl border border-secondary-200 bg-white px-5 py-6 text-center font-semibold text-secondary-900 shadow-sm">
              <span class="absolute left-4 top-3 text-xs font-bold text-primary-600">{String(index + 1).padStart(2, '0')}</span>
              {label}
              {index < 3 && <span class="absolute -right-5 z-10 hidden text-2xl text-primary-400 md:block" aria-hidden="true">→</span>}
            </li>
          ))}
        </ol>

        <div class="mx-auto mt-8 max-w-5xl rounded-xl border border-primary-200 bg-primary-50 p-5 text-sm leading-relaxed text-secondary-700 md:p-6">
          <p><strong class="text-secondary-900">Technischer Hintergrund:</strong> Bei vielen Installationen liegen die Daten von HS3 in einer Firebird-Datenbank mit dem Dateinamen <strong class="rounded bg-white px-1.5 py-0.5 font-mono text-primary-800">HS3.FDB</strong>. Zimmero kann diese vorhandene HS3 Datenbank direkt für die Migration auslesen. Ein mühsamer Export sämtlicher Daten in einzelne Excel- oder CSV-Dateien ist daher nicht notwendig.</p>
        </div>
      </div>
    </section>

    <section class="bg-surface py-16 md:py-24" aria-labelledby="umfang-heading">
      <div class="section-container">
        <div class="mx-auto mb-10 max-w-3xl text-center">
          <h2 id="umfang-heading" class="mb-4 text-2xl font-bold md:text-3xl">Was kann aus HS3 übernommen werden?</h2>
          <p class="text-secondary-600">Der konkrete Umfang richtet sich nach den Informationen, die in Ihrer vorhandenen HS3-Installation tatsächlich enthalten sind.</p>
        </div>

        <div class="mx-auto grid max-w-6xl gap-5 md:grid-cols-2 lg:grid-cols-3">
          {migrationGroups.map(group => (
            <section class="rounded-xl border border-secondary-200 bg-white p-6 shadow-sm last:md:col-span-2 last:lg:col-span-1">
              <h3 class="mb-4 text-lg font-semibold">{group.title}</h3>
              <ul class="space-y-2.5 text-sm text-secondary-700">
                {group.items.map(item => (
                  <li class="flex gap-2.5"><span class="text-success-600" aria-hidden="true">✓</span><span>{item}</span></li>
                ))}
              </ul>
            </section>
          ))}
        </div>

        <p class="mx-auto mt-8 max-w-4xl rounded-xl border border-secondary-200 bg-white p-5 text-sm leading-relaxed text-secondary-700">Vor dem Wechsel prüfen wir den vorhandenen Datenbestand und führen einen Testimport durch. So lässt sich vor der eigentlichen Umstellung kontrollieren, ob die relevanten Informationen korrekt übernommen werden.</p>
      </div>
    </section>

    <section id="ablauf" class="py-16 md:py-24" aria-labelledby="ablauf-heading">
      <div class="section-container">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="mb-3 text-sm font-semibold text-primary-700">Geplant statt überstürzt</p>
          <h2 id="ablauf-heading" class="mb-4 text-2xl font-bold md:text-3xl">So läuft der Wechsel von HS3 ab</h2>
          <p class="text-secondary-600">Wir stimmen Datenübernahme, Einrichtung und Wechseltermin mit Ihrem Betrieb ab und begleiten jeden Schritt persönlich.</p>
        </div>

        <ol class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-4">
          {migrationSteps.map((step, index) => (
            <li class="border-t-2 border-primary-400 pt-5">
              <p class="mb-3 text-sm font-bold text-primary-700">Schritt {index + 1}</p>
              <h3 class="mb-3 text-lg font-semibold">{step.title}</h3>
              <p class="text-sm leading-relaxed text-secondary-600">{step.text}</p>
            </li>
          ))}
        </ol>

        <div class="mx-auto mt-10 max-w-4xl rounded-xl border border-success-200 bg-success-50 p-5 text-sm leading-relaxed text-success-900"><strong>Ziel der Umstellung:</strong> Ihr Team findet die benötigten Gäste, Buchungen und Aufenthalte in Zimmero vor und führt den laufenden Hotelbetrieb dort weiter. Wie viel Vorbereitung notwendig ist, hängt vom Datenbestand, den Abläufen und den eingesetzten Schnittstellen ab.</div>
      </div>
    </section>

    <section id="zimmero" class="bg-secondary-950 py-16 text-white md:py-24" aria-labelledby="zimmero-heading">
      <div class="section-container">
        <div class="max-w-3xl">
          <p class="mb-3 text-sm font-semibold text-primary-300">Zimmero als HS3 Alternative</p>
          <h2 id="zimmero-heading" class="mb-5 text-3xl font-bold text-white md:text-4xl">Eine moderne Hotelsoftware für den Alltag im Hotel.</h2>
          <p class="text-lg leading-relaxed text-secondary-300">Zimmero wurde insbesondere für inhabergeführte Hotels, Pensionen und kleinere bis mittlere Hotelbetriebe entwickelt. Die Hotelsoftware bildet umfangreiche Abläufe ab, ohne die tägliche Bedienung unnötig kompliziert zu machen.</p>
        </div>

        <div class="mt-12 grid gap-x-10 gap-y-9 md:grid-cols-2 lg:grid-cols-4">
          {featureGroups.map(group => (
            <section>
              <h3 class="mb-4 text-lg font-semibold text-white">{group.title}</h3>
              <ul class="space-y-3 text-sm leading-relaxed text-secondary-300">
                {group.items.map(item => (
                  <li class="flex gap-2.5">
                    <span class="text-primary-300" aria-hidden="true">✓</span>
                    {item.href ? <a href={item.href} class="underline decoration-secondary-600 underline-offset-4 hover:text-white">{item.label}</a> : <span>{item.label}</span>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-surface py-16 md:py-24" aria-labelledby="einblicke-heading">
      <div class="section-container">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="mb-3 text-sm font-semibold text-primary-700">Echte Produkteinblicke</p>
          <h2 id="einblicke-heading" class="mb-4 text-2xl font-bold md:text-3xl">So sieht der Hotelalltag in Zimmero aus.</h2>
          <p class="text-secondary-600">Drei Ansichten aus der laufenden Software – keine Mockups und keine Stockbilder.</p>
        </div>

        <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-3">
          {screenshots.map(shot => (
            <figure class="overflow-hidden rounded-xl border border-secondary-200 bg-white shadow-sm">
              <img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} class="aspect-[16/10] w-full object-cover object-top" loading="lazy" />
              <figcaption class="border-t border-secondary-200 p-5">
                <strong class="block text-secondary-900">{shot.title}</strong>
                <span class="mt-1 block text-sm leading-relaxed text-secondary-600">{shot.text}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20" aria-labelledby="betreuung-heading">
      <div class="section-container">
        <div class="mx-auto grid max-w-5xl gap-8 rounded-2xl border border-secondary-200 p-7 shadow-sm md:grid-cols-[auto_1fr] md:items-center md:p-10">
          <div class="flex h-16 w-16 items-center justify-center rounded-full bg-primary-100 text-xl font-bold text-primary-700" aria-hidden="true">AH</div>
          <div>
            <p class="mb-2 text-sm font-semibold text-primary-700">Persönliche Betreuung</p>
            <h2 id="betreuung-heading" class="mb-3 text-2xl font-bold md:text-3xl">Kein anonymer Softwarewechsel.</h2>
            <p class="leading-relaxed text-secondary-600">Bei Einrichtung und Datenübernahme haben Sie mit Andreas Huber einen direkten Ansprechpartner, der das Produkt kennt und die Migration betreut. Zimmero wird in Bad Gögging entwickelt und betreut.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-primary-500 py-16 text-white md:py-20" aria-labelledby="produkt-cta-heading">
      <div class="section-container text-center">
        <div class="mx-auto max-w-3xl">
          <h2 id="produkt-cta-heading" class="mb-4 text-2xl font-bold text-white md:text-3xl">Sie nutzen aktuell noch HS3?</h2>
          <p class="leading-relaxed text-primary-100">Dann prüfen wir unverbindlich, welche Daten aus Ihrem bestehenden System übernommen werden können und wie eine Umstellung auf Zimmero aussehen würde.</p>
          <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
            <a href={migrationMail} data-event="HS3 Datenuebernahme angefragt" class="inline-flex items-center justify-center rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-primary-700 transition hover:bg-primary-50">Datenübernahme prüfen lassen</a>
            <a href="/demo/" class="inline-flex items-center justify-center rounded-full border border-white/50 px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-primary-600">Zimmero Demo ansehen</a>
          </div>
          <p class="mt-5 text-sm text-primary-100">Oder schreiben Sie direkt an <a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-white underline underline-offset-4">{CONTACT_EMAIL}</a></p>
        </div>
      </div>
    </section>

    <div class="border-b border-secondary-200 bg-secondary-50 py-12 md:py-16">
      <div class="section-container">
        <div class="mx-auto max-w-4xl text-center">
          <p class="mb-3 text-sm font-semibold text-primary-700">Weiterführender Ratgeber</p>
          <h2 class="mb-4 text-2xl font-bold md:text-3xl">Was HS3-Nutzer über den Wechsel wissen sollten</h2>
          <p class="text-secondary-600">Sachliche Hintergründe zu HS3, Mews, dem geplanten Auslaufen und der Auswahl einer passenden Alternative.</p>
        </div>
      </div>
    </div>

    <div class="section-container py-16 md:py-24">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[minmax(0,1fr)_280px]">
        <div class="min-w-0">
          <div class="mb-10 rounded-xl border border-warning-200 bg-warning-50 p-5 text-sm leading-relaxed text-warning-900"><strong>Stand dieses Beitrags: 10. September 2026.</strong> Maßgeblich für Ihren Betrieb bleiben individuelle Vertragsinformationen und aktuelle Mitteilungen von HS3 beziehungsweise Mews.</div>

          <div class="grid gap-14 leading-relaxed text-secondary-700">
            <section id="hs3-eingestellt" aria-labelledby="hs3-eingestellt-heading">
              <h2 id="hs3-eingestellt-heading" class="mb-5 text-2xl font-bold md:text-3xl">Wird HS3 eingestellt?</h2>
              <p><strong class="text-secondary-900">HS3 ist zum Auslaufen vorgesehen – die Hotelsoftware ist heute aber noch nicht abgeschaltet.</strong> Mews hat HS3 im Mai 2024 übernommen. In der offiziellen FAQ steht, dass die HS3-Produkte bis zu ihrem künftigen Auslaufen funktionsfähig und unterstützt bleiben sollen. Als voraussichtlicher Zeitraum werden die drei Jahre nach Mai 2024 genannt. Daraus lässt sich ungefähr Mai 2027 ableiten; ein verbindliches tagesgenaues Enddatum nennt die FAQ nicht.</p>
              <p class="mt-4">HS3 schreibt zugleich, dass Kunden vorerst weiter unterstützt und bestehende Vereinbarungen eingehalten werden. Sachlich richtig ist deshalb: HS3 soll auslaufen, befindet sich aber noch im Übergang.</p>
              <div class="mt-6 rounded-xl bg-primary-50 p-5 text-sm text-primary-900"><strong>Was das praktisch bedeutet:</strong> Es besteht kein Grund für einen ungeprüften Schnellwechsel. Es ist aber sinnvoll, Datenbestand, Schnittstellen und mögliche HS3 Nachfolger rechtzeitig zu klären, solange ein geordneter Testimport vorbereitet werden kann.</div>
            </section>

            <section id="hs3-und-mews" aria-labelledby="hs3-und-mews-heading">
              <h2 id="hs3-und-mews-heading" class="mb-5 text-2xl font-bold md:text-3xl">HS3 und Mews: Was ist offiziell bekannt?</h2>
              <ol class="space-y-5 border-l-2 border-primary-200 pl-6">
                <li><h3 class="font-semibold text-secondary-900">April und Mai 2024: Vereinbarung und Übernahme</h3><p class="mt-1">HS3 und Mews vereinbarten die Übernahme im April 2024. Mews gab ihren Abschluss am 13. Mai 2024 bekannt.</p></li>
                <li><h3 class="font-semibold text-secondary-900">Übergangsphase: HS3 bleibt zunächst nutzbar</h3><p class="mt-1">Laut HS3 bleiben die Produkte vorerst funktionsfähig und werden unterstützt. Der HS3-Support bleibt während einer möglichen Migration Ansprechpartner.</p></li>
                <li><h3 class="font-semibold text-secondary-900">Mews Hospitality Cloud als angebotene Migrationslösung</h3><p class="mt-1">Bestehenden HS3-Kunden wird ein Wechsel zu Mews angeboten. Daraus folgt jedoch keine Pflicht, dieses System zu wählen.</p></li>
                <li><h3 class="font-semibold text-secondary-900">Voraussichtliches Auslaufen</h3><p class="mt-1">Die offizielle FAQ nennt die auf Mai 2024 folgenden drei Jahre als Erwartung. Weil dort kein festes Enddatum steht, sollte jeder Betrieb seine konkrete Support- und Vertragslage bestätigen lassen.</p></li>
              </ol>
            </section>

            <section id="nachfolger" aria-labelledby="nachfolger-heading">
              <h2 id="nachfolger-heading" class="mb-5 text-2xl font-bold md:text-3xl">Muss Mews der HS3-Nachfolger sein?</h2>
              <p>Nein. Mews ist die von HS3 angebotene Migrationslösung. Ein bestehender HS3-Nutzer kann grundsätzlich auch andere Hotelsoftwares prüfen und die Alternative wählen, die zu den tatsächlichen Abläufen des Hauses passt.</p>
              <p class="mt-4">Ein inhabergeführtes Hotel, eine Pension oder ein Aparthotel braucht möglicherweise eine andere Kombination aus Funktionsumfang, Betreuung und Kosten als eine internationale Hotelgruppe. Lassen Sie sich deshalb alltägliche Vorgänge zeigen: eine telefonische Buchung, einen Zimmerwechsel, eine geteilte Rechnung oder eine Portalbuchung.</p>
              <p class="mt-4">Wenn die Übernahme bestehender Daten für Sie entscheidend ist, kann Zimmero den vorhandenen HS3-Datenbestand direkt für die Migration auslesen. <a href="#datenuebernahme" class="font-medium text-primary-700 hover:underline">Weiter oben finden Sie Umfang und Ablauf der HS3 Datenübernahme.</a></p>
            </section>

            <section id="alternative-pruefen" aria-labelledby="alternative-pruefen-heading">
              <h2 id="alternative-pruefen-heading" class="mb-5 text-2xl font-bold md:text-3xl">Worauf sollte man bei einer HS3 Alternative achten?</h2>
              <p>Eine Funktionsliste allein zeigt noch nicht, wie gut eine HS3 Hotelsoftware Alternative im eigenen Betrieb funktioniert. Klären Sie insbesondere diese Punkte:</p>
              <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2">
                {['Umfang und Prüfung der Datenübernahme', 'bestehende und zukünftige Reservierungen', 'Gästestammdaten und historische Daten', 'Zimmerplan und tägliche Rezeptionsabläufe', 'Rechnungen und Leistungen', 'Channel Manager und Booking.com Anbindung', 'Direktbuchung über die eigene Website', 'Meldeschein und Online Check-in', 'Kurtaxe beziehungsweise Ortstaxe', 'DATEV und Buchhaltung', 'Housekeeping', 'vorhandene Schnittstellen', 'Support und Schulung', 'Kosten und Vertragslaufzeit'].map(item => (
                  <li class="flex gap-3"><span class="text-primary-600" aria-hidden="true">✓</span><span>{item}</span></li>
                ))}
              </ul>
              <p class="mt-6">Bei Zimmero wird der vorhandene Datenbestand vorab geprüft. Ein Testimport zeigt vor der produktiven Umstellung, welche Informationen in der neuen Umgebung ankommen.</p>
            </section>

            <section id="checkliste" aria-labelledby="checkliste-heading">
              <h2 id="checkliste-heading" class="mb-5 text-2xl font-bold md:text-3xl">Checkliste vor dem Wechsel von HS3</h2>
              <p>Bevor der Wechseltermin feststeht, sollten Hotelbetriebe diese Fragen beantworten:</p>
              <ul class="mt-6 space-y-4">
                <li><strong class="text-secondary-900">Daten:</strong> Welche Stamm-, Buchungs- und historischen Daten werden weiterhin benötigt?</li>
                <li><strong class="text-secondary-900">Reservierungen:</strong> Welche zukünftigen Buchungen und bestehenden Aufenthalte sind vorhanden?</li>
                <li><strong class="text-secondary-900">Schnittstellen:</strong> Welche Buchungsportale, Kassen, Schließsysteme und Zahlungsanbieter sind angebunden?</li>
                <li><strong class="text-secondary-900">Abrechnung:</strong> Wie laufen Rechnungsstellung, DATEV, Meldeschein und Kurtaxe heute ab?</li>
                <li><strong class="text-secondary-900">Benutzer:</strong> Wer benötigt Zugriff und welche Rechte sind nötig?</li>
                <li><strong class="text-secondary-900">Testfälle:</strong> Welche normalen und besonderen Buchungen sollen im Testimport geprüft werden?</li>
                <li><strong class="text-secondary-900">Termin:</strong> Welcher Stichtag liegt außerhalb einer starken An- oder Abreisewelle?</li>
                <li><strong class="text-secondary-900">Team:</strong> Wer sollte Testimport, Einrichtung und Schulung begleiten?</li>
              </ul>
              <p class="mt-6 rounded-xl border border-secondary-200 bg-secondary-50 p-5 text-sm">Bei einem Wechsel zu Zimmero gehen wir diese Punkte gemeinsam durch und prüfen den tatsächlichen Datenbestand vorab mit einem Testimport.</p>
            </section>

            <section id="quellen" aria-labelledby="quellen-heading">
              <h2 id="quellen-heading" class="mb-5 text-2xl font-bold md:text-3xl">Offizielle Quellen zu HS3 und Mews</h2>
              <ul class="space-y-3">
                <li><a href="https://hs3-hotelsoftware.de/kundenbereich/faq/" target="_blank" rel="noopener" class="font-medium text-primary-700 hover:underline">HS3: FAQ zur Übernahme durch Mews</a></li>
                <li><a href="https://hs3-hotelsoftware.de/kundenbereich/aktuelle-nachrichten-fuer-sie/" target="_blank" rel="noopener" class="font-medium text-primary-700 hover:underline">HS3: Aktuelle Nachrichten für Kunden</a></li>
                <li><a href="https://www.mews.com/de/presse/mews-treibt-mit-hs3-hotelsoftware-die-expansion-in-deutschland-voran" target="_blank" rel="noopener" class="font-medium text-primary-700 hover:underline">Mews: Mitteilung zur Übernahme von HS3 vom 13. Mai 2024</a></li>
              </ul>
            </section>
          </div>

          <section id="fragen" aria-labelledby="fragen-heading" class="mt-16 border-t border-secondary-200 pt-12">
            <h2 id="fragen-heading" class="mb-3 text-2xl font-bold md:text-3xl">Häufige Fragen zur HS3 Alternative</h2>
            <p class="mb-8 text-secondary-600">Antworten zu HS3, möglichen Nachfolgern, HS3.FDB und der Datenmigration zu Zimmero.</p>
            <FaqAccordion faqs={faqs} />
          </section>
