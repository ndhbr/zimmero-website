---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Layout from '../layouts/Layout.astro';
import { CONTACT_HOURS, DEMO_URL, SOFTWARE_APPLICATION_SCHEMA } from '../config';
import { addOns, plans } from '../data/pricing';

const faqs = [
  {
    q: 'Wann wird eine Kündigung wirksam?',
    a: 'Zimmero ist monatlich kündbar. Die Kündigung wird zum Ersten eines Monats wirksam.',
  },
  {
    q: 'Was kosten zusätzliche Schulungen und individuelle Arbeiten?',
    a: 'Einrichtung, Datenübernahme und eine halbtägige Schulung über Microsoft Teams sind kostenlos. Weitere Schulungen und individuelle Arbeiten bieten wir vor der Beauftragung gesondert an.',
  },
  {
    q: 'Bietet Zimmero Tarife für mehr als fünf Häuser oder 100 Zimmer an?',
    a: 'Ja. Für größere Betriebe und besondere Schnittstellen erstellen wir ein individuelles Angebot.',
  },
  {
    q: 'Welche Kosten können bei externen Anbietern anfallen?',
    a: 'Gebühren von Buchungsportalen, Zahlungsanbietern, Website-Anbietern und anderen externen Diensten richten sich nach Ihren Verträgen mit den jeweiligen Anbietern.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Layout
  title="Hotelsoftware Preise ab 99 € netto pro Monat | Zimmero"
  description="Zimmero Starter 99 €, Professional 199 €, Multi Property 299 € netto monatlich. Alle Grundfunktionen, kostenlose Datenmigration und Teams-Schulung."
  structuredData={[SOFTWARE_APPLICATION_SCHEMA, faqSchema]}
>
  <div class="border-b border-secondary-200/80 bg-[#f7f9fe] pb-9 pt-5 md:pb-11">
    <div class="product-container">
      <Breadcrumbs items={[{ name: 'Startseite', href: '/' }, { name: 'Preise', href: '/preise/' }]} />

      <div class="mb-7 md:mb-9">
        <h1 class="product-title !text-[clamp(2.45rem,5vw,3.9rem)]">Preise für Ihre Hotelsoftware</h1>
        <p class="mt-3 max-w-3xl text-secondary-600 sm:text-lg">Alle Tarife enthalten dieselben Grundfunktionen. Wählen Sie nach Größe, Support und Erweiterungen.</p>
      </div>

      <div class="grid gap-4 lg:grid-cols-3">
        {plans.map((plan, i) => (
          <article class:list={['flex flex-col rounded-2xl border bg-white p-5 sm:p-6', i === 1 ? 'border-primary-400 shadow-[0_10px_28px_-19px_rgba(33,51,122,.5)]' : 'border-secondary-200']}>
            <h2 class="text-xl font-semibold">{plan.name}</h2>
            <p class="mt-3 flex flex-wrap items-baseline gap-x-2 gap-y-0">
              <strong class="text-[2.55rem] font-semibold leading-none tracking-[-0.06em] text-secondary-950">{plan.price} €</strong>
              <span class="text-sm text-secondary-600">netto pro Monat</span>
            </p>
            <p class="mt-3 text-sm font-medium text-secondary-800 lg:min-h-10">{plan.capacity}</p>
            <p class="mt-4 rounded-lg bg-primary-50 px-3 py-2 text-sm font-semibold text-primary-800">{plan.extensions}</p>
            <div class="mt-4 flex-1 border-t border-secondary-200 pt-4">
              <h3 class="mb-2 text-sm font-semibold">Support</h3>
              <ul class="product-list">
                {plan.support.map(service => <li>{service}</li>)}
              </ul>
            </div>
            <a href="/kontakt/" class:list={['mt-5', i === 1 ? 'btn-primary' : 'btn-secondary']} aria-label={`Tarif anfragen für ${plan.name}`}>Tarif anfragen</a>
          </article>
        ))}
      </div>

      <div class="mt-5 grid gap-3 text-sm leading-relaxed text-secondary-700 sm:grid-cols-2 sm:gap-6">
        <p><strong class="text-secondary-900">Vertrag.</strong> Monatlich kündbar. Zahlung per SEPA-Lastschrift. Alle Preise netto zzgl. Umsatzsteuer.</p>
        <p><strong class="text-secondary-900">Wechsel.</strong> Einrichtung, Datenmigration und eine halbtägige Schulung über Microsoft Teams sind kostenlos.</p>
      </div>

      <p class="mt-4 text-sm text-secondary-700"><strong>Servicezeiten.</strong> {CONTACT_HOURS}.</p>
      <details id="tarifregeln" class="mt-5 rounded-xl border border-secondary-200 bg-white px-4 py-3 text-sm">
        <summary class="cursor-pointer font-semibold text-primary-700">Abrechnung zusätzlicher Einsätze</summary>
        <div class="mt-3 max-w-4xl space-y-2 leading-relaxed text-secondary-700">
          <p>E-Mails können jederzeit gesendet werden. WhatsApp-Support ist in Professional und Multi Property enthalten.</p>
          <p>Weitere Telefonate bei Starter und Professional kosten innerhalb der Servicezeiten 70 € pro Stunde. Die Mindestdauer beträgt 30 Minuten, danach rechnen wir in 15-Minuten-Schritten ab.</p>
          <p>Ein Notfall ist eine akute technische Störung, die den laufenden Hotelbetrieb unmittelbar beeinträchtigt. Akute Einsätze außerhalb der Servicezeiten kosten bei Starter und bei Professional nach Ausschöpfung des Kontingents 120 € pro Stunde. Die Mindestdauer beträgt eine Stunde, danach rechnen wir in 15-Minuten-Schritten ab. Einsätze außerhalb der Servicezeiten sind auch an Wochenenden und Feiertagen nach Verfügbarkeit möglich. Eine garantierte Rufbereitschaft gibt es in keinem Tarif.</p>
          <p>Die Behebung von Zimmero-Fehlern ist kostenlos. Entsprechende Telefonate werden beim Kontingent nicht mitgezählt.</p>
        </div>
      </details>
    </div>
  </div>

  <section id="grundfunktionen" class="product-section" aria-labelledby="grundfunktionen-heading">
    <div class="product-container">
      <h2 id="grundfunktionen-heading" class="product-heading">In jedem Tarif enthalten</h2>
      <p class="mb-7 mt-3 max-w-3xl text-secondary-600">Der vollständige Grundumfang für Rezeption, Vertrieb, Abrechnung und Hotelbetrieb.</p>
      <FeatureGrid complete />
    </div>
  </section>

  <section id="zusatzmodule" class="product-section border-y border-secondary-200/80 bg-secondary-50" aria-labelledby="module-heading">
    <div class="product-container">
      <h2 id="module-heading" class="product-heading">Optionale Zusatzmodule</h2>
      <div class="mb-7 mt-3 max-w-4xl space-y-2 text-secondary-600">
        <p>Professional enthält drei reguläre Erweiterungen nach Wahl, Multi Property alle regulären Erweiterungen. Das gilt für myOBS, Gastronomie-Tablet, externe Kassensysteme, Zimmero Bell, SumUp Solo und das digitale Kassenbuch.</p>
        <p>TOMAS ist in allen Tarifen separat buchbar. Der TOMAS-Modulpreis deckt den Channel Manager und neue Portalbuchungen ab. Beim einzelnen Channel Manager gelten sie tarifübergreifend.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {addOns.map((addOn, index) => (
          <article class:list={['product-card flex min-w-0 flex-col', index === 0 && '!border-primary-300 !bg-primary-50']}>
            <h3 class="text-lg">{addOn.name}</h3>
            <p class="mt-3 flex flex-wrap items-baseline gap-x-1.5 leading-snug">
              <strong class="text-xl font-semibold text-secondary-950">{addOn.price}</strong>
              <span class="text-xs text-secondary-600">{addOn.unit}</span>
            </p>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-secondary-600">{addOn.description}</p>
            {addOn.href && <a href={addOn.href} class="product-link mt-4" aria-label={`Details zu ${addOn.name}`}>Details <span aria-hidden="true">→</span></a>}
          </article>
        ))}
      </div>
      <a href="/schnittstellen/" class="product-link mt-6">Alle Schnittstellen und Datenimporte <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="faq" class="product-section" aria-labelledby="faq-heading">
    <div class="product-container grid gap-8 lg:grid-cols-[1.5fr_1fr] lg:items-start">
      <div>
        <h2 id="faq-heading" class="product-heading mb-5">Häufige Fragen zu den Preisen</h2>
        <FaqAccordion faqs={faqs} />
      </div>
      <div class="product-cta rounded-[1.5rem] p-6 sm:p-8">
        <h2 class="text-2xl font-semibold tracking-tight">Zimmero selbst ausprobieren</h2>
        <p class="mt-2 text-sm leading-relaxed text-primary-100">Öffnen Sie die Demo mit Beispieldaten oder fragen Sie uns zu Ihrem Betrieb.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={DEMO_URL} target="_blank" rel="noopener" class="btn-primary">Demo öffnen <span aria-hidden="true">↗</span></a>
          <a href="/kontakt/" class="btn-secondary">Kontakt</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
