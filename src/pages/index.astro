---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import { DEMO_URL, SOFTWARE_APPLICATION_SCHEMA } from '../config';
import { plans } from '../data/pricing';

const logos = [
  { name: 'Booking.com', image: 'bookingcom.webp', href: '/channel-manager-booking-com/' },
  { name: 'Expedia', image: 'expedia.webp', href: '/channel-manager-booking-com/#portale' },
  { name: 'Airbnb', image: 'airbnb.webp', href: '/channel-manager-booking-com/#portale' },
  { name: 'OBS OnlineBuchungService', image: 'obs.webp', href: '/schnittstellen/#tourismus' },
  { name: 'DATEV-Export', href: '/datev-export-hotel/' },
  { name: 'Holidu Smart Destination', href: '/schnittstellen/#tourismus' },
];
---

<Layout
  title="Zimmero | All-in-One-Hotelsoftware für inhabergeführte Hotels"
  description="Hotelsoftware für Hotels, Pensionen und Gasthöfe mit Zimmerplan, kostenloser Buchungsstrecke, DATEV und optionalem Channel Manager. Ab 99 € netto im Monat."
  structuredData={SOFTWARE_APPLICATION_SCHEMA}
>
  <HeroSection />

  <section id="funktionen" aria-labelledby="funktionen-heading" class="product-section">
    <div class="product-container">
      <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="funktionen-heading" class="product-heading">Was in Zimmero steckt</h2>
          <p class="mt-2 text-secondary-600">Dieselben Grundfunktionen in jedem Tarif, vom Zimmerplan bis zum DATEV-Export.</p>
        </div>
        <a class="product-link" href="/preise/#grundfunktionen">Alle Grundfunktionen <span aria-hidden="true">→</span></a>
      </div>
      <FeatureGrid />
    </div>
  </section>

  <section id="zusatzmodule" aria-labelledby="vorteile-heading" class="product-section border-y border-secondary-200/80 bg-secondary-50">
    <div class="product-container">
      <h2 id="vorteile-heading" class="product-heading mb-7">Direktbuchungen, Portale und Kassenbuch</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <article class="flex flex-col overflow-hidden rounded-2xl border border-primary-100 bg-[#eaf0ff] md:row-span-2">
          <div class="p-6 sm:p-8">
            <p class="product-kicker mb-2">In jedem Tarif enthalten</p>
            <h3 class="text-2xl font-semibold tracking-tight">Kostenlose Buchungsstrecke</h3>
            <p class="mt-3 max-w-md text-secondary-700">Gäste buchen im Design Ihrer Hotelwebsite. Die Reservierung landet direkt in Zimmero. Sie zahlen weder Provision noch Buchungsgebühren an Zimmero.</p>
            <a href="/online-buchungssystem-hotelwebsite/" class="product-link mt-4">Buchungsstrecke ansehen <span aria-hidden="true">→</span></a>
          </div>
          <figure class="product-frame mx-5 mb-5 mt-auto sm:mx-8 sm:mb-8">
            <img src="/assets/online-direktbuchung-960.webp" srcset="/assets/online-direktbuchung-960.webp 960w, /assets/online-direktbuchung-neu.webp 1327w" sizes="(min-width: 1264px) 520px, (min-width: 768px) 43vw, 85vw" alt="Zimmero Buchungsstrecke mit Verfügbarkeit und Zimmerauswahl für Hotelgäste" width="960" height="672" loading="lazy" decoding="async" />
          </figure>
        </article>

        <article id="channel-manager" class="product-card grid gap-4 sm:grid-cols-[1fr_8rem] sm:items-center xl:grid-cols-[1fr_11rem]">
          <div>
            <p class="product-kicker mb-2">Optional</p>
            <h3 class="text-xl font-semibold tracking-tight">Zimmero Channel Manager</h3>
            <p class="mt-2 text-sm leading-relaxed text-secondary-600">Preise und Verfügbarkeiten zentral pflegen. Buchungen von Booking.com und weiteren Portalen kommen direkt in Zimmero an.</p>
            <a href="/channel-manager-booking-com/" class="product-link mt-3">Channel Manager ansehen <span aria-hidden="true">→</span></a>
          </div>
          <figure class="overflow-hidden rounded-lg border border-secondary-200 bg-secondary-50">
            <img src="/assets/channel-manager.webp" alt="Zimmero Channel Manager mit Optionen für automatischen Preisabgleich und Buchungsabruf" width="875" height="446" class="block h-auto w-full" loading="lazy" decoding="async" />
          </figure>
        </article>

        <article class="product-card grid gap-4 border-primary-100 sm:grid-cols-[1fr_8rem] sm:items-center xl:grid-cols-[1fr_11rem]">
          <div>
            <p class="product-kicker mb-2">Optional</p>
            <h3 class="text-xl font-semibold tracking-tight">Digitales Kassenbuch mit KI</h3>
            <p class="mt-2 text-sm leading-relaxed text-secondary-600">Bargeldbewegungen erfassen, Belege mit dem Smartphone fotografieren und die erkannten Daten samt Belegen nach DATEV exportieren.</p>
            <a href="/digitales-kassenbuch-hotel/" class="product-link mt-3">Kassenbuch ansehen <span aria-hidden="true">→</span></a>
          </div>
          <figure class="overflow-hidden rounded-lg border border-secondary-200 bg-secondary-50">
            <img src="/assets/kassenbuch/ki-belegerkennung.webp" alt="Beleg und von der KI erkannte Angaben nebeneinander in Zimmero" width="1170" height="842" class="block h-auto w-full" loading="lazy" decoding="async" />
          </figure>
        </article>
      </div>
      <a href="/preise/#zusatzmodule" class="product-link mt-5">Alle Zusatzmodule und Preise <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="schnittstellen" aria-labelledby="schnittstellen-heading" class="product-section">
    <div class="product-container">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="schnittstellen-heading" class="product-heading">Schnittstellen für Ihren Betrieb</h2>
          <p class="mt-2 text-secondary-600">Buchungsportale, Tourismus, Meldewesen und Buchhaltung.</p>
        </div>
        <a href="/schnittstellen/" class="product-link">Alle Schnittstellen <span aria-hidden="true">→</span></a>
      </div>
      <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-secondary-200 bg-secondary-200 sm:grid-cols-3 lg:grid-cols-6">
        {logos.map(logo => (
          <li class="min-w-0 bg-white">
            <a href={logo.href} class="flex h-24 items-center justify-center px-4 text-center text-sm font-semibold text-secondary-800 hover:bg-primary-50">
              {logo.image ? (
                <img src={`/assets/schnittstellen/${logo.image}`} alt={logo.name} width="112" height="52" class="h-[3.25rem] w-28 object-contain" loading="lazy" decoding="async" />
              ) : logo.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="umstieg" aria-labelledby="umstieg-heading" class="product-section border-y border-secondary-200/80 bg-secondary-50">
    <div class="product-container grid gap-7 md:grid-cols-[1.05fr_1fr] md:items-center md:gap-12">
      <div>
        <p class="product-kicker mb-3">Preise und Wechsel</p>
        <h2 id="umstieg-heading" class="product-heading">Ab {plans[0].price} € netto pro Monat.</h2>
        <p class="mt-3 text-secondary-600">Monatlich kündbar. Zum Start richten wir Zimmero für Ihren Betrieb ein und begleiten Ihr Team bei der Umstellung.</p>
        <a href="/preise/" class="btn-primary mt-6">Tarife vergleichen <span aria-hidden="true">→</span></a>
      </div>
      <div class="product-card">
        <h3 class="text-lg font-semibold">Kostenlos zum Start</h3>
        <ul class="product-list mt-3">
          <li>Einrichtung für Ihren Betrieb</li>
          <li>Übernahme vorhandener Gäste- und Buchungsdaten</li>
          <li>Halbtägige Schulung per Microsoft Teams</li>
        </ul>
        <a href="/wissen/hs3-alternative/" class="product-link mt-4">Wechsel von HS3 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="faq" aria-labelledby="demo-heading" class="product-section">
    <div class="product-container">
      <div class="product-cta flex flex-wrap items-center justify-between gap-6 rounded-[1.5rem] px-6 py-8 sm:px-9 sm:py-10 lg:px-12">
        <div>
          <h2 id="demo-heading" class="product-heading">Passt Zimmero zu Ihrem Hotel?</h2>
          <p class="mt-2 text-primary-100">Probieren Sie Zimmero mit Beispieldaten aus. Die Demo öffnet sich ohne Anmeldung.</p>
          <a href="/preise/#faq" class="mt-3 inline-block text-sm font-semibold text-white underline underline-offset-4">Häufige Fragen zu Preisen und Vertrag</a>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={DEMO_URL} target="_blank" rel="noopener" class="btn-primary">Demo öffnen <span aria-hidden="true">↗</span></a>
          <a href="/kontakt/" class="btn-secondary">Unverbindlich anfragen</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
